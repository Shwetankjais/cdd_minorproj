# Leave DATABASE_URL blank to run with SQLite on the host.
DATABASE_URL=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GIT_WRITE_TOKEN=
# DEVPULSE_REPO=/absolute/path/to/cdd_minor
# DEVPULSE_WORKSPACE=/absolute/path/to/cdd_minor/workspace
# Optional chat tool selection. Recognized commands work without a model.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Hosted deployments
# DEVPULSE_MODE=cloud
# HTTPS *.vercel.app and localhost:5173 are allowed in cloud mode by default.
# Set additional exact HTTPS origins, or use '*' in cloud mode for any origin without cookies.
# DEVPULSE_CORS_ORIGINS=https://your-project.vercel.app
# Set DEVPULSE_SESSION_ENCRYPTION_KEY in the hosting provider's secret variables.
